# ==========================================
# Football Analytics Hub - Environment Config
# ==========================================

# Sumber Data: "mock" | "football-data" | "api-football" | "fotmob" | "footystats"
DATA_PROVIDER=mock

# API Keys (JANGAN hardcode di kode, isi di .env)
FOOTBALL_DATA_API_KEY=
API_FOOTBALL_KEY=
FOOTYSTATS_API_KEY=

# Database & Cache (PostgreSQL + Redis untuk Docker Compose)
DATABASE_URL=postgresql+psycopg2://fah_user:fah_password@postgres:5432/football_analytics
REDIS_URL=redis://redis:6379/0

# Keamanan / Auth Opsional
JWT_SECRET=ganti_dengan_secret_key_panjang_dan_acak
JWT_ALGORITHM=HS256
GOOGLE_CLIENT_ID=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
